{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dovetail",
  "homepage": "https://www.alexisbenoliel.fr",
  "items": [
    {
      "name": "dovetail-core",
      "type": "registry:lib",
      "title": "Dovetail core",
      "description": "Tokens, the Tailwind 4 theme, the recipes (every component's classes) and the configured `cn`. Required by every Dovetail component.",
      "dependencies": ["clsx", "tailwind-merge", "class-variance-authority"],
      "files": [
        {
          "path": "src/lib/cn.ts",
          "type": "registry:lib"
        },
        {
          "path": "src/lib/recipes.ts",
          "type": "registry:lib"
        },
        {
          "path": "src/styles/tokens.css",
          "type": "registry:file",
          "target": "~/styles/dovetail/tokens.css"
        },
        {
          "path": "src/styles/theme.css",
          "type": "registry:file",
          "target": "~/styles/dovetail/theme.css"
        },
        {
          "path": "src/styles/dovetail.css",
          "type": "registry:file",
          "target": "~/styles/dovetail/dovetail.css"
        }
      ],
      "docs": "Import the theme once, after Tailwind, in your global stylesheet: @import \"tailwindcss\"; @import \"../styles/dovetail/dovetail.css\"; (adjust the relative path) and remove shadcn's default :root/.dark variables and @theme block so they do not override Dovetail's."
    },
